{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whittle",
  "version": "0.1.1",
  "identifier": "dev.whittle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Whittle", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 560, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "category": "DeveloperTool",
    "shortDescription": "A fast, clean Git client",
    "longDescription": "Whittle is a desktop Git client: history graph, staging by line, branches, merge and rebase, stash, issues and pull requests.", "active": true, "targets": ["deb", "appimage"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"] }
}
